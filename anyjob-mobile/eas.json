{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "credentialsSource": "local",
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824039305",
        "ascApiKeyPath": "$ANYJOB_ASC_KEY_PATH",
        "ascApiKeyId": "66935F4CZ7",
        "ascApiKeyIssuerId": "c8f7799d-e7d6-47ae-a774-44c129f454fa"
      }
    }
  }
}
