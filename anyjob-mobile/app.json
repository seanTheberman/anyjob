{
  "expo": {
    "name": "AnyJob",
    "slug": "anyjob-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anyjob",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ie.anyjob.mobile",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:anyjob-mu.vercel.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow AnyJob to use your approximate area when posting or finding nearby work.",
        "NSPhotoLibraryUsageDescription": "Allow AnyJob to attach photos to jobs, profiles, messages, and support requests.",
        "NSCameraUsageDescription": "Allow AnyJob to take photos for jobs, profiles, messages, and verification.",
        "NSMicrophoneUsageDescription": "Allow AnyJob to record audio when attaching media to a request or message."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "ie.anyjob.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AnyJob to use your approximate area when posting or finding nearby work."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12b1ebde-e4b2-4f98-8472-3db0c3951f56"
      }
    },
    "owner": "shipiotech",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/12b1ebde-e4b2-4f98-8472-3db0c3951f56"
    }
  }
}
